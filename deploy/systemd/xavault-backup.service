[Unit]
Description=Xavault encrypted PostgreSQL backup
After=network-online.target

[Service]
Type=oneshot
User=xavault
Group=xavault
EnvironmentFile=/etc/xavault/backup.env
WorkingDirectory=/opt/xavault
ExecStart=/bin/sh /opt/xavault/scripts/backup_database.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/xavault
